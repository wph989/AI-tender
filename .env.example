# docker compose 的部署变量（Compose v2 自动读仓库根目录的这个文件，复制成 .env 后生效）。
# 只服务容器编排；在宿主机直接跑 uvicorn / celery 用的是 apps/api/.env，两者同名同义。
# 生产环境必须改掉所有默认口令，并且 LLM_SECRET_KEYS 不能为空（否则管理页存不了供应商密钥）。

# 镜像标签：同一批部署用同一个值，方便回滚时按标签找回镜像
IMAGE_TAG=dev

# ---- 对外端口（都只绑 127.0.0.1，由反向代理转发）----
WEB_PORT=4321
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# Gotenberg 是单独部署的一份编排（docker/gotenberg/），它的镜像 / 端口 / 内存都在那份目录的 .env 里配；
# 本文件只保留客户端要用的变量（见下面 Gotenberg 段），所以这里没有 GOTENBERG_PORT。
# MinerU 的宿主端口用 8100 而不是 8000：宿主机 uvicorn 默认也占 8000，两边同时发布会撞车；
# 容器里的 api / worker 走服务名 http://mineru:8000，与这个宿主端口无关。
MINERU_PORT=8100

# ---- PostgreSQL ----
POSTGRES_USER=tender
POSTGRES_PASSWORD=tender
POSTGRES_DB=tender
# 连接串。用容器内服务名 postgres；要接外部库就改这一行（驱动固定 psycopg 3）。
# 必须与上面的 POSTGRES_* 保持一致，否则 api 连的是一个空库。
DATABASE_URL=postgresql+psycopg://tender:tender@postgres:5432/tender

# ---- Redis（Celery broker + 配置缓存）----
REDIS_URL=redis://redis:6379/0

# ---- MinIO / S3 兼容存储 ----
# 镜像必须钉版本、不要用 latest：浮动标签会把控制台和对象语义一起换掉——2025-05-24 的社区版把内置 Web
# 控制台标记为弃用并迁到单独的 object-browser 项目（LDAP / OIDC 登录也移出社区版），而对象存储是溯源
# 数据的源头。下面这个默认值是那次改动之前最后一个版本；不需要控制台就换更新版本，并删掉 compose 里
# 9001 那行端口。换版本要跟转换器 / 解析器一起评审。
MINIO_IMAGE=minio/minio:RELEASE.2025-04-22T22-12-26Z
# 一次性容器的 mc 客户端，只用来建桶 + 开版本化；两条都是标准 S3 接口，不必与 server 同版本
MINIO_MC_IMAGE=minio/mc:RELEASE.2025-08-13T08-35-41Z
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
S3_BUCKET=ai-tender
S3_REGION=us-east-1
# 接外部对象存储时改下面三项，并手工把桶与版本化建好（minio-init 只作用于自带 MinIO）：
# S3_ENDPOINT_URL=https://minio.内网域名
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
#   mc alias set prod https://minio.内网域名 <AK> <SK>
#   mc mb --ignore-existing prod/ai-tender && mc version enable prod/ai-tender

# ---- Gotenberg（Office → PDF；单独部署，见 docker/gotenberg/）----
# 镜像 / 端口 / 内存 / 请求预算都在 docker/gotenberg/.env 里配（那份编排自带 .env.example，两个目录一起拷）；
# 本文件只保留客户端要用的变量。
# 指向那侧副本入口 gotenberg-lb 的地址：同机部署用下面这个默认值（compose 给各后端服务加了
# host.docker.internal:host-gateway 映射，Linux 上也能解析），分机部署改成 http://<主机>:3000。
# 加副本 / 换副本都在 Gotenberg 那一侧，这里不用动。
# GOTENBERG_URL=http://host.docker.internal:3000
# Basic Auth：两个都填才启用；只填一个应用侧会直接报错
GOTENBERG_USER=
GOTENBERG_PASS=
# 客户端预算（apps/api 的 GOTENBERG_TIMEOUT_SECONDS），必须 ≥ Gotenberg 那侧的 GOTENBERG_API_TIMEOUT：
# 短了会「服务端还在转、worker 已经断开」，worker 槽白占着却拿不到结果（依据见 docs/调研/02 第 5 节）。
GOTENBERG_TIMEOUT_SECONDS=1800

# ---- MinerU（解析）----
# 下面这些变量服务仓库根 docker-compose.yml 里的 mineru（已有独立部署的 MinerU 时用不到）
MINERU_IMAGE=mineru:4.0.7-cu121
MINERU_TIER=standard
MINERU_TABLE_DEVICE=auto
# 用自带的 mineru 服务时必须显式设置：容器里 MinerU 用这个值启动，api 用同一个值鉴权。
# 对接无鉴权的外部 MinerU 时留空；对接有鉴权的外部服务时按对方要求填。
MINERU_API_KEY=local-dev-key
# 接外部 MinerU 时指向它（api / worker 用）
# MINERU_URL=http://mineru.内网域名:8000

# bbox 实测值（scripts/verify_coords.py 跑完再填）：unknown 时只存文本与锚点，不写坐标
MINERU_BBOX_ORIGIN=unknown
MINERU_BBOX_ROTATION=unknown

# ---- LLM 模型配置 ----
# 模型、端点与密钥只在「模型管理」页登记，运行时不读 .env，也不回退这里的旧变量。
# 旧的 LLM_BASE_URL / LLM_MODEL / LLM_API_KEY / LLM_TIMEOUT_SECONDS 已废弃，勿再填写；
# 详见 docs/设计/12-LLM管理与模型路由.md 第 5 节（密钥与回退）。
# 供应商密钥的加密主密钥（Fernet，逗号分隔，第一个用于加密、其余用于解密轮换）
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LLM_SECRET_KEYS=

# ---- 其它 ----
# 单租户预留；所有资源查询都带这个 company_id
COMPANY_ID=1
# worker 并发数；受 GPU 与 LLM 速率约束，不是越大越好
# 一个全队列 worker 的总线程数；调度、轮询与长任务共享线程池。
WORKER_CONCURRENCY=7

# 容器运行日志；纯 stdout 由 Docker 按大小/数量轮转，不使用下方天数清理。
# 需要按日留存时改为 file 或 both，文件保存在 backendlogs 卷的 /app/logs。
LOG_LEVEL=INFO
LOG_OUTPUT=stdout
LOG_CONSOLE_FORMAT=json
LOG_RETENTION_DAYS=30
LOG_TIMEZONE=Asia/Singapore
LOG_MAX_FILE_BYTES=104857600
LOG_CLEANUP_INTERVAL_SECONDS=3600
