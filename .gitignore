# 依赖与构建产物
node_modules/
.next/
dist/
coverage/
*.tsbuildinfo
.claude/

# 前端生成物：pdfjs 的 worker/cMaps/字体由 scripts/copy-pdfjs-assets.mjs 从 node_modules 复制
apps/web/public/pdfjs/
apps/web/next-env.d.ts
# E2E 临时截图（人工验收用，不进版本库）
apps/web/.e2e-*.png
apps/web/test-results/
apps/web/playwright-report/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.venv/

# 本地临时工作目录（诊断脚本、uv/pytest 缓存，不进版本库）
.tmp/
.cache/
# 本地存储包含上传原件和解析产物。
/apps/api/.storage/

# 命令输出日志（本地排查用，不进版本库）
*.log
# 结构化运行日志含 JSONL 分片，不能只忽略 *.log。
logs/

# 环境与编辑器
.env
.vscode/
.idea/

# 自有字体（商业授权，由部署方提供）：只保留说明与占位文件
docker/gotenberg/fonts/*
!docker/gotenberg/fonts/README.md
!docker/gotenberg/fonts/.gitkeep

