# 复制成同目录 .env 后按机器情况改（docker compose 只读同目录的 .env；.env 已在 .gitignore 里，不要提交）。
# 这份编排对外只有一个入口：gotenberg-lb 的 GOTENBERG_PORT。客户端（AI-Tender 的 api / worker）指这个端口：
#   同机容器部署 → GOTENBERG_URL=http://host.docker.internal:3000
#   宿主进程或分机 → GOTENBERG_URL=http://<主机>:3000

# 发布在哪个网卡上：0.0.0.0 允许别的机器调用（生产配合防火墙只放行 api / worker），只想本机用就写 127.0.0.1
GOTENBERG_BIND=0.0.0.0
GOTENBERG_PORT=3000

# Basic Auth：两项必须成对。只填一个官方镜像会以「未启用鉴权」启动，而应用侧（getenberg_credentials）会直接报错；
# 不想启用就删掉这两行，但必须靠网络隔离（只允许 api / worker 网段访问）。
GOTENBERG_USER=tender
GOTENBERG_PASS=

# 基础镜像与本地镜像名。建议钉到具体版本：converter_version 会写进 document_version，
# 换基础镜像等于改变分页口径，属于要评审的变更。
GOTENBERG_IMAGE=gotenberg/gotenberg:8
GOTENBERG_LOCAL_IMAGE=tender-gotenberg:8

# 单副本内存上限：大文档内存压力会以 500 暴露，不够就调大或加副本；副本是独立进程，各占一份上限，
# 所以总内存按「副本数 × 这个值」估。
GOTENBERG_MEMORY=2g
# 单次转换的服务端预算（注入容器后叫 API_TIMEOUT，实际硬超时再多 5s）。官方默认只有 30s：
# 600 MB 级标书实测要十几分钟（docs/调研/02 第 5 节），客户端 GOTENBERG_TIMEOUT_SECONDS 必须 ≥ 这个值。
# 注意副本解决的是「同时转几份」，不是「一份能转多久」。
GOTENBERG_API_TIMEOUT=1800s
# 注入容器后叫 LOG_LEVEL（GOTENBERG_ 前缀对日志参数无效，写了不会生效）
GOTENBERG_LOG_LEVEL=info
