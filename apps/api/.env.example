# 复制成 .env 后按本机情况修改（.env 已在 .gitignore 里，不要提交）。
# 取值优先级：真实环境变量 > 本文件 > 代码里的默认值（见 src/tender/core/settings.py）。
# 改完即生效，不用重启任何服务：读的是文件而不是驻留内存的副本。

# PostgreSQL 连接串。驱动用 psycopg 3（postgresql+psycopg://）：
# 它同一个包既支持同步也支持异步，alembic 走同步、应用走异步都用它，不必再引第二个驱动。
# 容器里按 docker-compose 的服务名连：postgresql+psycopg://tender:密码@postgres:5432/tender
DATABASE_URL=postgresql+psycopg://tender:tender@localhost:5432/tender

# Office → PDF 转换服务（Gotenberg，见 docs/调研/02）。容器里按服务名连：
# GOTENBERG_URL=http://gotenberg:3000
GOTENBERG_URL=http://localhost:3000
# 服务以 Basic Auth 启动时填这两项；两个都不填表示本地不带鉴权（必须成对出现）。
GOTENBERG_USER=
GOTENBERG_PASS=

# 自托管 MinerU /v1 API。生产部署应配置 API Key。
MINERU_URL=http://localhost:8000
MINERU_API_KEY=

# 单租户预留；本期固定为 1，所有资源查询仍通过此配置过滤。
COMPANY_ID=1

# Redis 仅承担 Celery broker；任务状态和快照以 PostgreSQL 为准。
REDIS_URL=redis://localhost:6379/0

# MinIO / S3 兼容存储。生产环境使用内网地址和独立凭据。
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=ai-tender
S3_REGION=us-east-1
# MinerU bbox 方向须先用 scripts/verify_coords.py 实测；unknown 时只保存文本和锚点。
MINERU_BBOX_ORIGIN=unknown
# 旋转页也须实测为 visual（已按视觉方向）或 unrotated（需按 PDF /Rotate 转换）。
MINERU_BBOX_ROTATION=unknown

# OpenAI Chat Completions 兼容的内网模型网关；未配置时抽取任务不会写入结果。
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=90

# 供应商密钥的加密主密钥（Fernet）：逗号分隔，第一个用于加密、其余用于解密，支持轮换。
# 生成：python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 留空时管理页仍能打开，但保存密钥会返回 secret_key_unavailable。
LLM_SECRET_KEYS=
